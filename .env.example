# scripts/left.sh init(= python3 scripts/init_env.py)이 실제 값으로 .env를 만든다. .env는 커밋하지 않는다.
POSTGRES_PASSWORD=replace-with-a-random-password
SESSION_SECRET=replace-with-a-random-64-hex
POSTGRES_PORT=5432
# api를 서버 밖(Tailscale 등)에 열 때만 바꾼다. 예: 100.74.97.103
API_BIND=127.0.0.1
API_PORT=8000
# 브라우저 Origin 허용 목록(쉼표 구분). 개발: Vite 주소
ALLOWED_ORIGINS=http://localhost:5173
# HTTPS로 배포할 때만 true
COOKIE_SECURE=false
# 원본 영상·변환본·썸네일·스냅샷을 둘 서버 폴더
MEDIA_ROOT_HOST=./data/media
# 도보 경로 계산용. 직접 입력
KAKAO_REST_API_KEY=

# 모델 스크립트(scripts/tracklet_pipeline.py)를 컨테이너 밖에서 쓸 때만
POSTGRES_HOST=127.0.0.1
POSTGRES_DB=capstone
POSTGRES_USER=capstone
